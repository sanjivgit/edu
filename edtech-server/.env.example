# ─── Environment ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=v1
# JWT secrets (rotate in production)
JWT_ACCESS_SECRET=educore_dev_access_secret_change_me
JWT_REFRESH_SECRET=educore_dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/educore?schema=public"
# Frontend origin for CORS
CORS_ORIGIN=http://localhost:5173
# App URL used for reset links / file serving
APP_BASE_URL=http://localhost:5173
# Optional email provider SMTP (used by notifications)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
